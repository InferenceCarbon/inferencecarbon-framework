# Credentials and local configuration — present from the first commit, per the
# population walkthrough. The engine reads API keys from local key files that
# must never be committed.
.env
.env.*
!.env.example
*.key
*.pem
token.json
credentials.json
client_secret*.json
config.yaml
secrets/
*APIKey*.txt
*Key.txt

# Engine run state and outputs (the frozen corpus is committed as data/*.zip)
results/
_runlogs/
bench_logs/
spend_state*.json
deferred_*.json
*.bak-*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Notebooks and editors
.ipynb_checkpoints/
.DS_Store
.vscode/
.idea/

# Scratch copy written by data/fetch_corpus.py
data/corpus/
*.jsonl.gz

# Reproduction outputs (regenerated; compare against reproduce/expected/)
reproduce/out/
